{{'lotion-lp.css' | asset_url | stylesheet_tag}}



{% assign collection = section.settings.all_collections %}
{%assign product = section.settings.all_products %}



<header class="cabecalho">
    <h1>{{page.title}}</h1>
</header>

<br>

<section>
    <main>
        <p>{{page.content}}</p>

        <h2>{{collection.title}}</h2>
        <p>{{collection.description}}</p>
    </main>


    {% for product in collection.products%}

     <div>
        
        <h3>{{product.title}} </h3>
        <p>{{product.price | money}}</p>
        <img src="{{product.featured_image |  image_url: width: "120px"}}" alt="{{product.featured_image.alt}}" />
        </div>
        
    {% endfor %}

</section>




{% schema %}
{
    "name": "lotion-lp",
    "settings": [
            {
                "type" :"collection",
                "id": "all_collections",
                "label": "Coleção"
            },

            {
                "type": "product",
                "id": "all_products",
                "label": "Produtos"
            }
        ],

    "presets": [{
        "name": "lotion-lp"
    }
    
        
    ]
}
{% endschema %}